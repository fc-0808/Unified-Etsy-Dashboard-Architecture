# Required before network exposure. Generate with: npm run auth:generate-secret
DASHBOARD_OWNER_PASSWORD=
DASHBOARD_AUTH_SECRET=

# Prefer named employee accounts (`npm run user -- add`) over shared passwords.
DASHBOARD_PACKER_PASSWORD=
DASHBOARD_SHOPPER_PASSWORD=

# Runtime
PORT=4000
# Change to 0.0.0.0 only after authentication and firewall rules are verified.
HOST=127.0.0.1
# Change to 1 only after config, OAuth, auth, and the compliance report are verified.
EMBEDDED_SYNC=0

# Optional exact origins, comma-separated. Leave empty for same-origin only.
DASHBOARD_CORS_ORIGINS=
# Default trusts forwarding headers only from a loopback proxy (e.g. cloudflared).
# Set an explicit hop count/IP only for a reverse proxy you control.
DASHBOARD_TRUST_PROXY=loopback

# Optional isolated paths
DASHBOARD_CONFIG_PATH=
DASHBOARD_TOKENS_PATH=
DASHBOARD_BACKUP_DIR=
DASHBOARD_BACKUP_KEEP=14

# Optional AI listing assistance. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
VISION_API_KEY=
VISION_BASE_URL=
OPENAI_VISION_MODEL=gpt-5.4
# ─────────────────────────────────────────────────────────────────────────────
# Bulk Listing Creator — environment configuration
#
# Copy this file to ".env" and fill in your real values. ".env" is gitignored
# and NEVER committed. Etsy shop credentials/proxies still live in config.json;
# this file only holds the OpenAI key + bulk-listing tuning knobs.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI — used to generate titles, descriptions, tags and to classify product
# images (grip / charm / MagSafe detection). Required for the Bulk Listings tab.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Model used for both the vision-classification pass and the SEO copy pass.
# A vision-capable model is required (e.g. gpt-5, gpt-4o, gpt-4.1).
OPENAI_MODEL=gpt-5

# ── Bulk-run tuning (optional — sensible defaults are applied if omitted) ──────

# Default state for newly created listings: "draft" (recommended) or "published".
LISTING_DEFAULT_STATE=draft

# How many products to process concurrently per shop. Keep low (1-2) to respect
# Etsy's 5 QPS / 5,000 QPD per-app-key rate limits — each product is ~13-16 calls.
BULK_CONCURRENCY=1

# Target stock quantity assigned to every enabled variation offering.
BULK_RESTOCK_QUANTITY=3

# Absolute path to the 4-currency pricing master workbook. Defaults to the file
# bundled in the project root if left blank.
# PRICING_WORKBOOK_PATH=C:\path\to\Y2KASE_Pricing_Master_4_Currencies.xlsx

# ── 4PX label printing (Windows + Deli DL-720W thermal printer) ───────────────
# Print label bypasses the browser and routes through Adobe Acrobat (vector, 203
# dpi) — never the Windows default PDF handler (often Edge, which blurs barcodes).
LABEL_PRINTER_NAME=Deli DL-720W
# dialog = Adobe print dialog with your Fit / 80×80 mm settings (recommended)
# silent = Adobe /t one-click (uses last Adobe settings for this printer)
LABEL_PRINT_MODE=dialog
LABEL_PRINT_BACKEND=acrobat
LABEL_PRINT_SETTINGS=fit
# LABEL_PRINT_ACROBAT_PATH=C:\Program Files\Adobe\Acrobat DC\Acrobat\Acrobat.exe
# SUMATRA_PDF_PATH=C:\path\to\SumatraPDF.exe

# ── Sign-in & roles (optional — leave blank to run with no login) ─────────────
# Authentication turns ON as soon as DASHBOARD_OWNER_PASSWORD is set (or you add
# a named account via `npm run user -- add ...`). Until then the dashboard is
# open on your LAN exactly as before.
#
#   owner   → full access (you)
#   packer  → the employee role: the whole fulfilment side of the business —
#             the Orders queue (buy → verify → pack → ship → 4PX labels), the
#             Route tab (Orders Sorting Dashboard, shopping-route generation)
#             and full CRUD on the case/grip/charm catalog behind it, plus the
#             Sourcing Library. Never sees earnings, Etsy listings, shop/OAuth
#             settings or staff accounts.
#   shopper → the mobile Shopping Route ONLY (never sees earnings/listings/admin)
#
# The exact permission per endpoint lives in src/auth/policy.js — one reviewable
# table, enforced on the server and used by the UI to decide what to show.
#
# You can either use these shared bootstrap passwords, or (recommended) create a
# named account per person so the audit log shows who did what and you can
# offboard one person instantly:  npm run user -- add mei shopper
DASHBOARD_OWNER_PASSWORD=
DASHBOARD_PACKER_PASSWORD=
DASHBOARD_SHOPPER_PASSWORD=
# Optional: pin the cookie-signing secret so sessions survive password changes /
# restarts. If omitted, one is derived from the passwords above.
# DASHBOARD_AUTH_SECRET=change-me-to-a-long-random-string

# ── Online Shopping Route (mobile) ────────────────────────────────────────────
# Your shopping employee opens  http://<this-pc>:4000/shop  on their phone, signs
# in with a `shopper` account, and gets a live, tap-to-update version of the
# Excel shopping route. Every status change syncs to your desktop Route tab (and
# any other phone) in real time.
#
# To use it "from anywhere / outside" WITHOUT opening router ports, expose this
# PC with a free Cloudflare Tunnel. Install the tool once:
#     winget install --id Cloudflare.cloudflared
#
# ── Option A · TEMPORARY link (zero setup) ────────────────────────────────────
# Just run:  npm run tunnel
# You get a free https://<random>.trycloudflare.com URL — but it CHANGES every
# run, so you must re-share the link each time. Good for a quick test.
#
# ── Option B · PERMANENT link (recommended, ~5 min, one time) ─────────────────
# A stable URL your staff bookmark once (e.g. https://shop.your-domain.com/shop).
# Requires a domain on your Cloudflare account (Cloudflare Registrar sells .com
# at cost, ~$10/yr; or add a domain you already own — the free plan is enough).
#
#   1. Add your domain: Cloudflare dashboard → "Add a domain" (free plan is fine).
#   2. Zero Trust → Networks → Tunnels → "Create a tunnel" → type "Cloudflared".
#      Name it e.g. "etsy-dashboard".
#   3. On the "Install connector" screen, copy the TOKEN (the long string after
#      "--token" in the command it shows). Paste it below as CLOUDFLARE_TUNNEL_TOKEN.
#   4. Add a "Public Hostname":
#        Subdomain: shop      Domain: your-domain.com
#        Service:   HTTP      URL: localhost:4000
#      Save. Put that same hostname (shop.your-domain.com) below.
#   5. Run:  npm run tunnel     → your permanent link is live.
#      (Optional, always-on: run an Administrator terminal and do
#       `npm run tunnel:install` to run it as a background service that starts on
#       boot — no window to keep open. Remove with `npm run tunnel:uninstall`.)
#
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...paste-the-long-token-here...
# CLOUDFLARE_TUNNEL_HOSTNAME=shop.your-domain.com
#
# Because the tunnel serves HTTPS, session cookies are automatically marked
# Secure — keep DASHBOARD_OWNER_PASSWORD (and a per-person shopper account) set
# so the internet-facing URL always requires a login.
#
# ── Option C · PERMANENT link, FREE, NO domain (Tailscale Funnel) ─────────────
# Gives a stable public URL like  https://<your-pc>.<tailnet>.ts.net  that never
# changes, stays up automatically (runs as a background service), needs NO domain
# and NO app on your employees' phones. Slightly higher latency than a Cloudflare
# domain tunnel, but rock-solid and $0.
#   1. Install Tailscale:  winget install --id Tailscale.Tailscale
#   2. Sign in once:       tailscale up      (opens a browser)
#   3. Turn it on:         npm run funnel    (prints your permanent link; enable
#                          Funnel for your tailnet if it asks — one-time link)
#   Turn it off any time:  npm run funnel:stop
# Employees open <that-url>/shop. Keep a login password set (above) since it is
# public.
