# Secret credentials — NEVER commit these
config.json
tokens.json
.env
.env.*
!.env.example

# SQLite database files (contain live order data)
data/
*.db
*.db-shm
*.db-wal

# Node dependencies
node_modules/

# Build output
dist/
build/

# Generated shopping-route files (large, regenerated on demand)
output/
supplier_catalog.xlsx

# Vendored route-engine: keep the code (src/, requirements.txt), ignore the
# bundled data + scratch dirs (large binaries / regenerated at runtime).
route-engine/data/
route-engine/data.moved-*/
route-engine/cache/
route-engine/input/
route-engine/output/

# Logs
logs/
*.log
npm-debug.log*

# Python bytecode
__pycache__/
*.pyc

# Local API scratch scripts (may contain credentials)
_fpx_test.js

# Local backups of secret files (API keys / OAuth tokens) — e.g.
# config.json.bak-<timestamp>, tokens.json.bak-<timestamp>. NEVER commit.
*.bak
*.bak-*
config.json.*
tokens.json.*

# Scratch / diagnostic scripts (throwaway, never part of the app)
_tmp_*

# Editor workspace settings (personal)
.vscode/

# OS junk
.DS_Store
Thumbs.db
