route-engine/data/
route-engine/cache/
route-engine/input/
route-engine/output/

# Logs
logs/
*.log
npm-debug.log*

# Python bytecode
__pycache__/
*.pyc

# Local API scratch scripts (may contain credentials)
_fpx_test.js

# OS junk
.DS_Store
Thumbs.db
