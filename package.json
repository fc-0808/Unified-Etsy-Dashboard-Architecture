{
  "name": "unified-etsy-dashboard",
  "version": "1.0.0",
  "main": "src/server/index.js",
  "description": "Unified local dashboard for 20 Etsy shops across 4 proxy-isolated groups",
  "scripts": {
    "oauth:setup": "node scripts/oauth-setup.js",
    "shop:remove": "node scripts/remove-shop.js",
    "complete:4px": "node scripts/complete-4px-pending.js",
    "compliance:check": "node -e \"const {loadConfig}=require('./src/config/schema');const g=require('./src/compliance/suspension-guard');const c=loadConfig();const r=g.analyzeSuspensionRisks(c);console.log(g.formatRiskReport(r));const s=g.summarizeRisks(r);if(s.status!=='ok')process.exit(1);\"",
    "proxy:test": "node test_proxy.js",
    "proxy:verify": "node scripts/verify-proxies.js",
    "db:setup": "node scripts/setup-db.js",
    "smoke-test": "node scripts/smoke-test.js",
    "verify:auth": "node scripts/verify-auth.js",
    "report": "node scripts/analytics-report.js",
    "user": "node scripts/user.js",
    "relocate-db": "node scripts/relocate-db.js",
    "test:dedup": "node scripts/test-dedup.js",
    "verify:dedup": "node scripts/verify-dedup-fix.js",
    "test:route-shop-filter": "node scripts/test-route-shop-filter.js",
    "test:pack-queue-exchange": "node scripts/test-pack-queue-exchange.js",
    "test:4px-label-names": "node scripts/test-4px-label-names.js",
    "test:4px-order-constraints": "node scripts/test-4px-order-constraints.js",
    "test:4px-product-preference": "node scripts/test-4px-product-preference.js",
    "dev": "node src/server/index.js",
		"tunnel": "node scripts/tunnel.js",
		"tunnel:install": "node scripts/tunnel.js --install-service",
		"tunnel:uninstall": "node scripts/tunnel.js --uninstall-service",
		"funnel": "node scripts/funnel.js",
		"funnel:stop": "node scripts/funnel.js --stop",
    "sync": "node src/workers/sync.js",
    "start": "node src/server/index.js",
    "smoke": "node scripts/smoke-test.js",
    "fetch-images": "node scripts/fetch-images.js",
    "backfill-images": "node scripts/backfill-images.js",
    "backfill-catalog-images": "node scripts/backfill-catalog-images.js",
    "sync:canonical-products": "node scripts/sync-canonical-products.js",
    "auto:start": "pm2 start ecosystem.config.js && pm2 save",
    "auto:stop": "pm2 stop etsy-dashboard",
    "auto:restart": "pm2 restart etsy-dashboard",
    "auto:status": "pm2 status",
    "auto:logs": "pm2 logs etsy-dashboard --lines 100",
    "auto:install": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "auto:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "tray:start": "powershell -WindowStyle Hidden -NonInteractive -ExecutionPolicy Bypass -File scripts/tray.ps1",
    "launch": "powershell -WindowStyle Hidden -NonInteractive -ExecutionPolicy Bypass -File scripts/start-dashboard.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "content-disposition": "^1.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "https-proxy-agent": "^9.0.0",
    "node-cron": "^4.2.1",
    "openai": "^6.41.0",
    "sharp": "^0.35.1",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pm2": "^7.0.1"
  }
}
